---
---

<div
  id="cookie-banner"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
  class="cookie-banner"
  hidden
>
  <div class="cookie-inner">
    <p class="cookie-text">
      We use Google Analytics to understand how visitors use this site.
      No data is collected until you accept.
      <a href="/privacy" class="cookie-link">Privacy policy</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-decline" class="cookie-btn cookie-btn--decline">Decline</button>
      <button id="cookie-accept" class="cookie-btn cookie-btn--accept">Accept</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--color-gray-900);
    border-top: 1px solid var(--color-gray-800);
    z-index: 9999;
    padding: 1rem 1.25rem;
  }

  .cookie-inner {
    max-width: 1280px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .cookie-text {
    flex: 1;
    min-width: 200px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-gray-400);
    line-height: 1.5;
  }

  .cookie-link {
    color: #FFFFFF;
    text-underline-offset: 2px;
  }

  .cookie-actions {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.125rem;
    border-radius: 4px;
    border: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 150ms ease;
  }

  .cookie-btn--decline {
    background: transparent;
    color: var(--color-gray-400);
    border-color: var(--color-gray-800);
  }

  .cookie-btn--decline:hover {
    color: #FFFFFF;
    border-color: var(--color-gray-600);
  }

  .cookie-btn--accept {
    background: var(--color-accent);
    color: var(--color-ink);
    border-color: var(--color-accent);
  }

  .cookie-btn--accept:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
  }
</style>

<script is:inline>
  (function () {
    var banner = document.getElementById('cookie-banner');
    var stored = localStorage.getItem('tf_consent');

    if (!stored) {
      banner.removeAttribute('hidden');
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
      localStorage.setItem('tf_consent', 'granted');
      if (typeof gtag === 'function') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
      banner.setAttribute('hidden', '');
    });

    document.getElementById('cookie-decline').addEventListener('click', function () {
      localStorage.setItem('tf_consent', 'denied');
      banner.setAttribute('hidden', '');
    });
  })();
</script>
