---
import { PHONE_DISPLAY, PHONE_TEL } from '../consts';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/membership', label: 'Membership' },
  { href: '/gym', label: 'The Gym' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-paper border-b border-gray-200">
  <div class="container">
    <div class="flex items-center justify-between h-16 md:h-18">

      <!-- Wordmark -->
      <a href="/" class="font-display font-bold text-xl tracking-tight text-ink no-underline">
        Tifton Fitness
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-7" aria-label="Main navigation">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`font-body text-sm font-medium no-underline transition-colors ${
              currentPath === href
                ? 'text-accent'
                : 'text-gray-600 hover:text-ink'
            }`}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Phone CTA (desktop) -->
      <a
        href={PHONE_TEL}
        class="hidden md:inline-flex items-center gap-2 btn-primary text-sm px-4 py-2"
      >
        {PHONE_DISPLAY}
      </a>

      <!-- Mobile: phone + hamburger -->
      <div class="flex md:hidden items-center gap-3">
        <a href={PHONE_TEL} class="font-body font-semibold text-sm text-accent no-underline">
          Call
        </a>
        <!-- CSS-only mobile menu toggle -->
        <label for="mobile-menu-toggle" class="cursor-pointer p-1" aria-label="Open menu">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="2" y1="6" x2="20" y2="6"/>
            <line x1="2" y1="11" x2="20" y2="11"/>
            <line x1="2" y1="16" x2="20" y2="16"/>
          </svg>
        </label>
      </div>

    </div>
  </div>

  <!-- Mobile menu (CSS toggle, no JS) -->
  <input type="checkbox" id="mobile-menu-toggle" class="sr-only peer" />
  <nav
    class="hidden peer-checked:block border-t border-gray-200 bg-paper md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="container py-4 flex flex-col gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`font-body font-medium text-base py-2 no-underline ${
            currentPath === href ? 'text-accent' : 'text-gray-800'
          }`}
        >
          {label}
        </a>
      ))}
      <a href={PHONE_TEL} class="btn-primary mt-3 text-center">
        Call {PHONE_DISPLAY}
      </a>
    </div>
  </nav>
</header>
