---
interface Props {
  variant?: 'default' | 'large';
}
const { variant = 'default' } = Astro.props;
---

{variant === 'large' ? (
  <div class="hours-large">
    <p class="open-label">Open</p>
    <p class="hours-display">24 / 7</p>
    <p class="hours-sub">365 days a year — including holidays</p>
  </div>
) : (
  <p class="hours-inline">Open 24/7 &mdash; 365 days a year</p>
)}

<style>
  .hours-large {
    text-align: center;
  }

  .open-label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.25rem;
  }

  .hours-display {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
  }

  .hours-sub {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-gray-600);
    margin: 0.5rem 0 0;
  }

  .hours-inline {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    margin: 0;
  }
</style>
