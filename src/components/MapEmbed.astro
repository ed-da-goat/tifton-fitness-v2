---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`map-wrap ${className}`}>
  <iframe
    title="Tifton Fitness location — 130 Hunt Rd B7, Tifton, GA 31793"
    src="https://maps.google.com/maps?q=130+Hunt+Rd+B7%2C+Tifton%2C+GA+31793&z=16&output=embed"
    width="100%"
    height="100%"
    style="border: 0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    sandbox="allow-scripts allow-same-origin"
  ></iframe>
</div>

<style>
  .map-wrap {
    width: 100%;
    height: 380px;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--color-gray-200);
  }
</style>
