---
import Layout from '../layouts/Layout.astro';
import MembershipCard from '../components/MembershipCard.astro';
import { getCollection } from 'astro:content';
import { PHONE_DISPLAY, PHONE_TEL, PHONE_E164, ADDRESS_STREET, ADDRESS_CITY, ADDRESS_STATE, ADDRESS_ZIP, SITE_URL, GLOFOX_BRANCH_ID } from '../consts';

const memberships = (await getCollection('membership')).sort(
  (a, b) => a.data.order - b.data.order
);

const faqs = (await getCollection('faq'))
  .filter((f) => f.data.category === 'Membership & Billing')
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ExerciseGym",
  "name": "Tifton Fitness",
  "url": SITE_URL,
  "telephone": PHONE_E164,
  "priceRange": "$30–$50/month",
  "description": "Gym memberships in Tifton, GA. Month-to-month or contract plans. 24/7 key card access.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": ADDRESS_STREET,
    "addressLocality": ADDRESS_CITY,
    "addressRegion": ADDRESS_STATE,
    "postalCode": ADDRESS_ZIP,
    "addressCountry": "US",
  },
  "openingHours": "Mo-Su 00:00-23:59",
};
---

<Layout
  title="Memberships — Tifton Fitness"
  description="Gym memberships in Tifton, GA. Month-to-month $50/mo or contract plans starting at $30/mo. 24/7 access, no hidden fees."
  jsonLd={jsonLd}
>

  <!-- ─── PAGE HEADER ───────────────────────────────────── -->
  <section class="page-header">
    <div class="container">
      <p class="page-eyebrow">Pricing</p>
      <h1 class="page-title">
        Simple gym memberships.<br />
        Choose your commitment.
      </h1>
      <p class="page-sub">
        Month-to-month flexibility or long-term savings — we have a plan for
        every commitment level. No hidden fees, no surprises.
      </p>
    </div>
  </section>

  <!-- ─── TIERS ─────────────────────────────────────────── -->
  <section class="section-pad bg-paper">
    <div class="container">
      <div class="membership-grid">
        {memberships.map((m) => (
          <MembershipCard
            name={m.data.name}
            price={m.data.price}
            period={m.data.period}
            tagline={m.data.tagline}
            features={m.data.features}
            cta={m.data.cta}
            ctaHref="#join"
            featured={m.data.featured}
          />
        ))}
      </div>

      <p class="pif-note">
        Prefer to pay upfront? 3-, 6-, and 12-month paid-in-full plans are also available — <a href="#join">see all options below</a>.
      </p>

      <p class="payment-note">
        We accept cash, checks, and all major credit and debit cards.
        Joining fees and monthly billing apply per plan — see full details below.
      </p>
    </div>
  </section>

  <!-- ─── INCLUDED WITH EVERY PLAN ─────────────────────── -->
  <section class="section-pad bg-gray-50">
    <div class="container">
      <h2 class="section-title">Included with every plan</h2>

      <div class="perks-grid">

        <div class="perk">
          <h3 class="perk-name">24/7 Key Card Access</h3>
          <p class="perk-desc">Your personal key card works every hour of every day. No staffed-hours restrictions.</p>
        </div>

        <div class="perk">
          <h3 class="perk-name">Full Equipment Access</h3>
          <p class="perk-desc">Cardio machines, free weights, cable systems, and functional training gear — all included.</p>
        </div>

        <div class="perk">
          <h3 class="perk-name">Clean & Maintained Facility</h3>
          <p class="perk-desc">We keep the gym spotless so you can focus on your workout, not the mess.</p>
        </div>

        <div class="perk">
          <h3 class="perk-name">Security Cameras & Lighting</h3>
          <p class="perk-desc">Monitored cameras and full lighting throughout — 24 hours a day.</p>
        </div>

        <div class="perk">
          <h3 class="perk-name">Free Orientation</h3>
          <p class="perk-desc">New to the gym? We'll walk you through every machine and answer your questions.</p>
        </div>

        <div class="perk">
          <h3 class="perk-name">Transparent Billing</h3>
          <p class="perk-desc">No hidden fees. Clear monthly billing — joining fees, terms, and rates spelled out up front.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── FAQ ───────────────────────────────────────────── -->
  <section class="section-pad bg-paper">
    <div class="container-prose">
      <h2 class="section-title">Membership questions</h2>

      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary class="faq-question">{f.data.question}</summary>
            <p class="faq-answer">{f.data.answer}</p>
          </details>
        ))}
      </div>

      <div class="faq-cta">
        <p class="faq-cta-text">Still have a question?</p>
        <a href={PHONE_TEL} class="btn-primary">Call {PHONE_DISPLAY}</a>
        <a href="/contact" class="btn-outline">Send a Message</a>
      </div>
    </div>
  </section>

  <!-- ─── JOIN / GLOFOX EMBED ──────────────────────── -->
  <section id="join" class="section-pad bg-paper">
    <div class="container">
      <h2 class="join-heading">Sign up today</h2>
      <p class="join-sub">
        Choose your plan and complete your membership below.
        All options — including 3-month and paid-in-full plans — are available here.
      </p>
      <div class="glofox-wrap">
        <iframe
          src={`https://app.glofox.com/portal/#/branch/${GLOFOX_BRANCH_ID}/memberships`}
          frameborder="0"
          width="100%"
          height="1200"
          title="Tifton Fitness membership signup"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-top-navigation-by-user-activation"
        ></iframe>
      </div>
      <p class="glofox-credit">
        <a href="https://www.glofox.com" target="_blank" rel="noopener noreferrer">
          powered by Glofox
        </a>
      </p>
    </div>
  </section>

</Layout>

<style>
  .page-header {
    padding-block: clamp(3rem, 7vw, 6rem);
    background-color: var(--color-paper);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .page-eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-ink);
    margin-bottom: 1.25rem;
    max-width: 700px;
  }

  .page-sub {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-gray-600);
    line-height: 1.65;
    max-width: 580px;
    margin: 0;
  }

  .membership-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .membership-grid { grid-template-columns: 1fr; max-width: 420px; }
  }

  .pif-note {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    margin-top: 1.75rem;
  }

  .pif-note a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .payment-note {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-gray-400);
    margin-top: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-ink);
    margin-bottom: 2.5rem;
  }

  .perks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .perks-grid { grid-template-columns: 1fr; }
  }

  .perk-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .perk-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.6;
    margin: 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-gray-200);
    margin-bottom: 3rem;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-gray-200);
  }

  .faq-question {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    padding: 1.25rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--color-gray-400);
    flex-shrink: 0;
    transition: transform 200ms;
  }

  details[open] .faq-question::after {
    transform: rotate(45deg);
  }

  .faq-answer {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.7;
    padding-bottom: 1.25rem;
    margin: 0;
  }

  .faq-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .faq-cta-text {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
  }

  .join-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }

  .join-sub {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-gray-600);
    line-height: 1.65;
    max-width: 600px;
    margin-bottom: 2.5rem;
  }

  .glofox-wrap iframe {
    display: block;
    width: 100%;
    height: 1200px;
    border-radius: 6px;
    border: 1px solid var(--color-gray-400);
  }

  @media (max-width: 768px) {
    .glofox-wrap iframe { height: 900px; }
  }

  .glofox-credit {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-gray-400);
    text-align: right;
    margin-top: 0.5rem;
  }

  .glofox-credit a {
    color: inherit;
    text-decoration: none;
  }

  .glofox-credit a:hover {
    color: var(--color-gray-600);
  }
</style>
