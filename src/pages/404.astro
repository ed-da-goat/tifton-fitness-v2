---
import Layout from '../layouts/Layout.astro';
import { PHONE_DISPLAY, PHONE_TEL } from '../consts';
---

<Layout
  title="Page Not Found — Tifton Fitness"
  description="The page you're looking for doesn't exist. Find our membership plans, gym info, and contact details at Tifton Fitness."
>

  <section class="not-found-section">
    <div class="container-prose text-center">
      <p class="eyebrow">404</p>
      <h1 class="title">Page not found.</h1>
      <p class="sub">
        That page doesn't exist. Try one of the links below, or give us a call.
      </p>
      <a href={PHONE_TEL} class="phone-link">{PHONE_DISPLAY}</a>
      <nav class="actions" aria-label="Return navigation">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/membership" class="btn-outline">Membership Plans</a>
        <a href="/contact" class="btn-outline">Contact Us</a>
      </nav>
    </div>
  </section>

</Layout>

<style>
  .not-found-section {
    padding-block: clamp(5rem, 12vw, 9rem);
    background-color: var(--color-paper);
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 1rem;
  }

  .title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--color-ink);
    margin-bottom: 1.25rem;
  }

  .sub {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-gray-600);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .phone-link {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    margin-bottom: 2.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
