# Google Analytics 4
# Real ID is in src/consts.ts — replace GA_MEASUREMENT_ID with your property's Measurement ID
# Found at: analytics.google.com → Admin → Data Streams → Web stream details
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Formspree (contact form submissions)
# Real ID is in src/consts.ts — replace FORMSPREE_FORM_ID with your form ID
# Found at: formspree.io → Your forms → Integration
FORMSPREE_FORM_ID=xxxxxxxx

# GloFox (membership portal embed)
# Real ID is in src/consts.ts — replace GLOFOX_BRANCH_ID with your branch ID
# Found at: GloFox portal → Settings → Integrations → Branch ID
GLOFOX_BRANCH_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Site URL (used for canonical URLs and sitemap generation)
# Must match astro.config.mjs site value exactly
SITE_URL=https://tiftonfitness.com
